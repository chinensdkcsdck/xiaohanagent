  latestIndicators: "鏈€鏂版寚鏍?,
  medicationStatus: "鐢ㄨ嵂鎯呭喌",
  insuranceType: "鍖讳繚绫诲瀷",
  medications: "褰撳墠鐢ㄨ嵂",
