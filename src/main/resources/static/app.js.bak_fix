  category: "宸ュ崟绫诲埆",
  content: "宸ュ崟鍐呭",
  priority: "浼樺厛绾?,
  reason: "澶嶈瘖鍘熷洜"
};

const state = {
  user: null,
  activeModule: modules[0].key,
  activeApi: modules[0].apis[0].name,
  forms: {},
  chatMessages: [{ role: "bot", text: "璇峰厛鐧诲綍銆傜櫥褰曞悗鍗冲彲鑷姩缁戝畾鐢ㄦ埛ID骞朵娇鐢ㄦ墍鏈夊姛鑳姐€? }]
};

function initForms() {
  modules.forEach((m) => {
    m.apis.forEach((api) => {
      state.forms[api.name] = {};
      api.fields.forEach((f) => { state.forms[api.name][f] = ""; });
    });
  });
}

function el(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

function currentModule() {
  return modules.find((m) => m.key === state.activeModule);
}

function currentApi() {
  return currentModule().apis.find((a) => a.name === state.activeApi);
}

function buildLayout() {
  const app = document.getElementById("app");
  app.innerHTML = "";
  const wrap = el("div", "workspace");
  wrap.append(buildHeader());
  if (!state.user) {
    wrap.append(buildLogin());
  } else {
    wrap.append(buildChatArea());
    wrap.append(buildBizArea());
  }
  app.append(wrap);
}

function buildHeader() {
  const header = el("header", "header");
  header.append(el("div", "logo"));
  const hTxt = el("div");
  hTxt.append(el("div", "title", "灏忔兜鍖荤枟绠＄悊绯荤粺"));
  hTxt.append(el("div", "subtitle", state.user
    ? `褰撳墠鐢ㄦ埛 ${state.user.username} 璐﹀彿 ${state.user.account} ID ${state.user.userId}`
    : "璇风櫥褰曞悗寮€濮嬩娇鐢?));
  header.append(hTxt);
  if (state.user) {
    const btn = el("button", "btn-danger", "閫€鍑虹櫥褰?);
    btn.onclick = logout;
    header.append(btn);
  }
  return header;
}

function buildLogin() {
  const box = el("section", "login-box");
  box.append(el("h2", "", "璐﹀彿鐧诲綍"));
  box.append(el("p", "login-tip", "婕旂ず璐﹀彿 zhangsan 鎴?lisi 瀵嗙爜 123456"));
  const account = document.createElement("input");
  account.className = "field-input";
  account.id = "login-account";
  account.placeholder = "璇疯緭鍏ヨ处鍙?;
  const pwd = document.createElement("input");
  pwd.className = "field-input";
  pwd.id = "login-password";
  pwd.type = "password";
  pwd.placeholder = "璇疯緭鍏ュ瘑鐮?;
  const username = document.createElement("input");
  username.className = "field-input";
  username.id = "register-username";
  username.placeholder = "娉ㄥ唽鏃惰杈撳叆濮撳悕";
  const idCard = document.createElement("input");
  idCard.className = "field-input";
  idCard.id = "register-id-card";
  idCard.placeholder = "娉ㄥ唽鏃惰杈撳叆韬唤璇?;
  const actionRow = el("div", "login-actions");
  const btn = el("button", "btn-primary", "鐧诲綍");
  btn.onclick = login;
  const regBtn = el("button", "btn-secondary", "娉ㄥ唽骞剁櫥褰?);
  regBtn.onclick = register;
  actionRow.append(btn, regBtn);
  const msg = el("div", "login-msg");
  msg.id = "login-msg";
  box.append(account, pwd, username, idCard, actionRow, msg);
  return box;
}

function buildChatArea() {
  const section = el("section", "ai-area");
  const left = el("div", "ai-left");
  left.append(el("div", "ai-title", "灏忔兜澶фā鍨嬪璇濅腑蹇?));
  left.append(el("div", "ai-subtitle", `宸茶嚜鍔ㄧ粦瀹氱敤鎴稩D ${state.user.userId}`));
  const board = el("div", "chat-board");
  state.chatMessages.forEach((m) => {
    const msg = el("div", `msg ${m.role}`);
    msg.append(el("span", "role", m.role === "user" ? "浣? : "灏忔兜"), document.createTextNode(m.text));
    board.append(msg);
  });
  left.append(board);

  const right = el("div", "ai-right");
  right.append(fieldTextarea("娑堟伅鍐呭", "chat-message", "璇疯緭鍏ヤ綘鐨勯棶棰?));
  const btn = el("button", "btn-primary", "鍙戦€佸璇?);
  btn.onclick = sendChat;
  right.append(btn);
  section.append(left, right);
  return section;
}

function buildBizArea() {
  const section = el("section", "biz-area");
  const side = el("aside", "side");
  side.append(el("div", "side-title", "涓氬姟妯″潡"));
  modules.forEach((m) => {
    const item = el("div", `side-item${m.key === state.activeModule ? " active" : ""}`);
    item.append(el("span", "dot"), document.createTextNode(m.title));
    item.onclick = () => {
      state.activeModule = m.key;
      state.activeApi = m.apis[0].name;
      buildLayout();
    };
    side.append(item);
  });

  const panel = el("main", "panel");
  const head = el("div", "panel-head");
  const nav = el("div", "api-nav");
  currentModule().apis.forEach((api) => {
    const chip = el("button", `chip${api.name === state.activeApi ? " active" : ""}`, api.name);
    chip.onclick = () => {
      state.activeApi = api.name;
      buildLayout();
    };
    nav.append(chip);
  });
  head.append(nav);
  panel.append(head, buildApiForm());
  section.append(side, panel);
  return section;
}

function buildApiForm() {
  const body = el("div", "panel-body");
  const api = currentApi();
  body.append(el("div", "api-meta", `${api.method} ${api.url}`));
  const form = el("div", "form-grid");
  api.fields.forEach((f) => {
    const box = el("div", "field");
    box.append(el("label", "field-label", labels[f] || f));
    if (["time", "oldTime", "newTime"].includes(f)) {
      const s = document.createElement("select");
      s.className = "field-input";
      ["", "涓婂崍", "涓嬪崍"].forEach((v) => {
        const op = document.createElement("option");
        op.value = v;
        op.textContent = v || "璇烽€夋嫨";
        if (state.forms[api.name][f] === v) op.selected = true;
        s.append(op);
      });
      s.oninput = (e) => { state.forms[api.name][f] = e.target.value; };
      box.append(s);
    } else if (["prepContent", "riskNotice", "symptoms", "medications", "reportText", "content"].includes(f)) {
      const ta = document.createElement("textarea");
      ta.className = "field-input";
      ta.rows = 3;
      ta.placeholder = `璇疯緭鍏?{labels[f] || f}`;
      ta.value = state.forms[api.name][f];
      ta.oninput = (e) => { state.forms[api.name][f] = e.target.value; };
      box.append(ta);
    } else {
      const input = document.createElement("input");
      input.className = "field-input";
      input.placeholder = `璇疯緭鍏?{labels[f] || f}`;
      input.value = state.forms[api.name][f];
      if (["date", "oldDate", "newDate"].includes(f)) input.type = "date";
      if (["age", "planId"].includes(f)) input.type = "number";
      input.oninput = (e) => { state.forms[api.name][f] = e.target.value; };
      box.append(input);
    }
    form.append(box);
  });
  body.append(form);
  const btn = el("button", "btn-success", "鎵ц鎺ュ彛");
  btn.onclick = () => callApi(api);
  body.append(btn);
  const result = el("pre", "result-box");
  result.id = "api-result";
  body.append(result);
  return body;
}

function fieldTextarea(labelText, id, placeholder) {
  const wrap = el("div", "field");
  wrap.append(el("label", "field-label", labelText));
  const area = document.createElement("textarea");
  area.className = "field-input";
  area.id = id;
  area.rows = 7;
  area.placeholder = placeholder;
  wrap.append(area);
  return wrap;
}

function cleanPayload(data) {
  const out = {};
  Object.keys(data).forEach((k) => {
    if (data[k] !== "" && data[k] !== null && data[k] !== undefined) out[k] = data[k];
  });
  return out;
}

async function callApi(api) {
  const result = document.getElementById("api-result");
  result.textContent = "璇锋眰涓?..";
  try {
    const payload = cleanPayload(state.forms[api.name]);
    let url = api.url;
    if (url.includes("{planId}")) {
      url = url.replace("{planId}", encodeURIComponent(payload.planId || ""));
    }
    const options = { method: api.method, headers: { Accept: "application/json, text/plain, */*" } };
    if (api.method === "GET") {
      const q = new URLSearchParams(payload).toString();
      if (q) url += `?${q}`;
    } else if (!api.plain) {
      options.headers["Content-Type"] = "application/json";
      options.body = JSON.stringify(payload);
    }
    const res = await fetch(url, options);
    const text = await res.text();
    let pretty = text;
    try { pretty = JSON.stringify(JSON.parse(text), null, 2); } catch (e) {}
    result.textContent = `鐘舵€?${res.status}\n${pretty}`;
  } catch (e) {
    result.textContent = `璇锋眰澶辫触\n${e.message}`;
  }
}

async function sendChat() {
  const message = (document.getElementById("chat-message").value || "").trim();
  if (!message) return;
  state.chatMessages.push({ role: "user", text: message });
  const bot = { role: "bot", text: "" };
  state.chatMessages.push(bot);
  buildLayout();
  try {
    const res = await fetch("/xiaohan/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "text/event-stream" },
      body: JSON.stringify({ message })
    });
    if (!res.ok || !res.body) {
      bot.text = `瀵硅瘽澶辫触 鐘舵€?${res.status}`;
      buildLayout();
      return;
    }
    const reader = res.body.getReader();
    const decoder = new TextDecoder("utf-8");
    let cache = "";
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;
      cache += decoder.decode(value, { stream: true });
      const lines = cache.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
      cache = lines.pop() || "";
      lines.forEach((line) => {
        if (line.startsWith("data:")) {
          bot.text += line.slice(5).trimStart();
        }
      });
      buildLayout();
    }
  } catch (e) {
    bot.text = `瀵硅瘽澶辫触 ${e.message}`;
  } finally {
    document.getElementById("chat-message").value = "";
    buildLayout();
  }
}

async function login() {
  const account = (document.getElementById("login-account").value || "").trim();
  const password = (document.getElementById("login-password").value || "").trim();
  const msg = document.getElementById("login-msg");
  if (!account || !password) {
    msg.textContent = "璇疯緭鍏ヨ处鍙峰拰瀵嗙爜";
    return;
  }
  try {
    const res = await fetch("/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ account, password })
    });
    const data = await res.json();
    if (!data.success) {
      msg.textContent = data.message || "鐧诲綍澶辫触";
      return;
    }
    applyAuthSuccess(data.user);
  } catch (e) {
    msg.textContent = `鐧诲綍澶辫触 ${e.message}`;
  }
}

async function register() {
  const account = (document.getElementById("login-account").value || "").trim();
  const password = (document.getElementById("login-password").value || "").trim();
  const username = (document.getElementById("register-username").value || "").trim();
  const idCard = (document.getElementById("register-id-card").value || "").trim();
  const msg = document.getElementById("login-msg");
  if (!account || !password || !username || !idCard) {
    msg.textContent = "娉ㄥ唽闇€瑕佸～鍐欒处鍙枫€佸瘑鐮併€佸鍚嶃€佽韩浠借瘉";
    return;
  }
  try {
    const res = await fetch("/auth/register", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ account, password, username, idCard })
    });
    const data = await res.json();
    if (!data.success) {
      msg.textContent = data.message || "娉ㄥ唽澶辫触";
      return;
    }
    applyAuthSuccess(data.user);
  } catch (e) {
    msg.textContent = `娉ㄥ唽澶辫触 ${e.message}`;
  }
}

function applyAuthSuccess(user) {
  state.user = user;
  state.chatMessages = [{ role: "bot", text: `娆㈣繋 ${state.user.username}锛岀郴缁熷凡鑷姩缁戝畾鐢ㄦ埛ID ${state.user.userId}` }];
  buildLayout();
}

async function loadMe() {
  try {
    const res = await fetch("/auth/me");
    const data = await res.json();
    if (data.success) {
      state.user = data.user;
      state.chatMessages = [{ role: "bot", text: `娆㈣繋鍥炴潵 ${state.user.username}` }];
    }
  } catch (e) {
    // ignore
  }
}

async function logout() {
  await fetch("/auth/logout", { method: "POST" });
  state.user = null;
  state.chatMessages = [{ role: "bot", text: "浣犲凡閫€鍑虹櫥褰曪紝璇烽噸鏂扮櫥褰曘€? }];
  buildLayout();
}

initForms();
loadMe().finally(buildLayout);
