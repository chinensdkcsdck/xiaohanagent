  newTime: "鏂版椂娈?,
  bizType: "涓氬姟椤圭洰",
  note: "澶囨敞",
  examType: "妫€鏌ラ」鐩?,
  planId: "璁″垝缂栧彿",
  prepContent: "鍑嗗鍐呭",
  riskNotice: "椋庨櫓鎻愮ず",
